{
  "name": "shape/monorepo",
  "description": "Shape framework monorepo — shape (generators, router, MCP) on top of shaperuntime (SQL gateway, auth, batch executor).",
  "type": "project",
  "license": "MIT",
  "authors": [
    {
      "name": "Urbidata"
    }
  ],
  "repositories": [
    { "type": "path", "url": "packages/shaperuntime", "options": { "symlink": true } },
    { "type": "path", "url": "packages/shape",        "options": { "symlink": true } }
  ],
  "require": {
    "php": ">=8.2",
    "shape/shape": "*",
    "shape/shaperuntime": "*"
  },
  "require-dev": {
    "phpstan/phpstan": "^2.1",
    "rector/rector": "^2.0",
    "symplify/easy-coding-standard": "^12.5",
    "nette/tester": "^2.5"
  },
  "config": {
    "sort-packages": true
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}
