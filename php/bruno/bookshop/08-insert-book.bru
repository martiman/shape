meta {
  name: Insert Book (auto-validated)
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/api.php
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{jwtToken}}
  Content-Type: application/json
}

body:json {
  {
    "op": "mutation",
    "payload": {
      "mutations": [
        {
          "table": "books",
          "action": "insert",
          "ref": "new_book",
          "data": {
            "title": "Children of Dune",
            "author_id": 1,
            "price": 11.49,
            "isbn": "978-0593098264",
            "stock": 10
          }
        }
      ]
    }
  }
}

tests {
  test("status is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("1 row inserted", function() {
    expect(res.body.results[0].affected).to.equal(1);
  });
}
