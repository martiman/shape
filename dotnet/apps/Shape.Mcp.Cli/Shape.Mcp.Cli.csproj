<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Shape.Mcp.Cli</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>

    <!-- dotnet tool packaging -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>shape-mcp</ToolCommandName>
    <PackageId>Shape.Mcp.Cli</PackageId>
    <Version>0.6.0</Version>
    <Authors>Shape</Authors>
    <Description>MCP (Model Context Protocol) stdio bridge for a Shape backend. Local-only — Claude Desktop / Cursor / Cline spawn this once per session.</Description>
    <PackageTags>mcp;shape;dotnet-tool;cli</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Shape.csproj" />
  </ItemGroup>

</Project>
